{
  "name": "da-frame-set",
  "version": "0.1.2",
  "description": "Device frames for React — laptops, phones, tablets, monitors and browser chrome, drawn in CSS.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daorbit/da-frame-set.git"
  },
  "homepage": "https://github.com/daorbit/da-frame-set#readme",
  "bugs": {
    "url": "https://github.com/daorbit/da-frame-set/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/da-frame-set.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config vite.site.config.ts",
    "prepublishOnly": "npm run build",
    "build:site": "vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts"
  },
  "keywords": [
    "react",
    "device-frame",
    "mockup",
    "preview",
    "responsive",
    "iphone",
    "macbook",
    "android"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "react-router-dom": "^7.18.3"
  }
}
